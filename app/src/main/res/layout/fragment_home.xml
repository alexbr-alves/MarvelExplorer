<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_500">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_constraint"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/text_teams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_corner"
                android:backgroundTint="@color/gray_300"
                android:fontFamily="@font/marvel"
                android:paddingVertical="20dp"
                android:paddingStart="20dp"
                android:text="@string/title_fragment_teams_and_groups"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_movies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_corner"
                android:backgroundTint="@color/gray_300"
                android:fontFamily="@font/marvel"
                android:paddingVertical="20dp"
                android:paddingStart="20dp"
                android:text="@string/title_fragment_movies"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
               app:layout_constraintTop_toBottomOf="@+id/text_teams"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_characters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_corner"
                android:backgroundTint="@color/gray_300"
                android:fontFamily="@font/marvel"
                android:paddingVertical="20dp"
                android:paddingStart="20dp"
                android:text="@string/title_fragment_characters"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/text_movies"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_comics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_corner"
                android:backgroundTint="@color/gray_300"
                android:fontFamily="@font/marvel"
                android:paddingVertical="20dp"
                android:paddingStart="20dp"
                android:text="@string/title_fragment_comic"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/text_characters"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_corner"
                android:backgroundTint="@color/gray_300"
                android:fontFamily="@font/marvel"
                android:paddingVertical="20dp"
                android:paddingStart="20dp"
                android:text="@string/title_fragment_event"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/text_comics"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>


