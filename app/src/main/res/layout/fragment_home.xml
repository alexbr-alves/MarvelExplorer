<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:paddingHorizontal="32dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_characters"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/background_gradient_rounded"
        android:paddingHorizontal="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_characters_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:lineHeight="17sp"
            android:text="@string/home_fragment_character_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_character"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_characters"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_characters_description"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_characters_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:lineHeight="17sp"
            android:text="@string/home_fragment_character_description"
            android:textColor="@color/deep_amethyst"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/image_character"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_characters_title" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_comics"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/background_gradient_rounded"
        android:paddingHorizontal="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contraint_characters">

        <TextView
            android:id="@+id/text_comic_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:text="@string/home_fragment_comic_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_comic_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:paddingBottom="8dp"
            android:text="@string/home_fragment_comic_description"
            android:textColor="@color/deep_amethyst"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/image_comic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_comic_title" />

        <ImageView
            android:id="@+id/image_comic"
            android:layout_width="130dp"
            android:layout_height="73dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_comics"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_comic_description"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_moveis"
        android:layout_width="167dp"
        android:layout_height="160dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/background_gradient_rounded"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contraint_comics">

        <ImageView
            android:id="@+id/image_movies"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/ic_movies"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_movies_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:text="@string/home_fragment_movies_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_movies" />

        <TextView
            android:id="@+id/text_movies_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:paddingBottom="8dp"
            android:text="@string/home_fragment_movies_description"
            android:textColor="@color/deep_amethyst"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/image_movies"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_movies_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_tvshow"
        android:layout_width="167dp"
        android:layout_height="160dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/background_gradient_rounded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contraint_comics">

        <ImageView
            android:id="@+id/image_tv_show"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/ic_tv_show"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_tv_show_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:text="@string/home_fragment_tv_show_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_tv_show" />

        <TextView
            android:id="@+id/text_tv_show_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:paddingBottom="8dp"
            android:text="@string/home_fragment_tv_show_description"
            android:textColor="@color/deep_amethyst"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/image_tv_show"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_tv_show_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_games"
        android:layout_width="167dp"
        android:layout_height="160dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/background_gradient_rounded"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contraint_moveis" >

        <ImageView
            android:id="@+id/image_games"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/ic_games"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_games_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:text="@string/home_fragment_games_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_games" />

        <TextView
            android:id="@+id/text_games_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:paddingBottom="8dp"
            android:text="@string/home_fragment_games_description"
            android:textColor="@color/deep_amethyst"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/image_games"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_games_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_teams"
        android:layout_width="167dp"
        android:layout_height="160dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/background_gradient_rounded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contraint_tvshow" >

        <ImageView
            android:id="@+id/image_teams"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/ic_team"
            android:alpha="0.3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_teams_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:text="@string/home_fragment_teams_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_teams" />

        <TextView
            android:id="@+id/text_teams_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:paddingBottom="8dp"
            android:text="@string/home_fragment_teams_description"
            android:textColor="@color/deep_amethyst"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/image_teams"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_teams_title" />
        
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
