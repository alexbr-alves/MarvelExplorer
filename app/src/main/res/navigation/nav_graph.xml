<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/detailsFragment"
        android:name="alexProject.fragment.DetailsFragment"
        android:label="detailsFragment"
        tools:layout="@layout/fragment_details">
        <argument
            android:name="character"
            app:argType="alexProject.network.response.CharacterModel" />
        <action
            android:id="@+id/action_detailsFragment_self"
            app:destination="@id/detailsFragment" />
        <argument
            android:name="comic"
            app:argType="alexProject.network.response.ComicModel" />
        <argument
            android:name="event"
            app:argType="alexProject.data.model.event.EventModel" />
        <action
            android:id="@+id/action_detailsFragment_to_CharacterFragment"
            app:destination="@id/CharacterFragment" />
        <action
            android:id="@+id/action_detailsFragment_to_comicsFragment"
            app:destination="@id/comicsFragment" />
        <action
            android:id="@+id/action_detailsFragment_to_eventFragment"
            app:destination="@id/eventFragment" />
    </fragment>
    <fragment
        android:id="@+id/favoriteCharacterFragment"
        android:name="alexProject.fragment.FavoriteFragment"
        android:label="FavoriteCharacterFragment"
        tools:layout="@layout/fragment_favorite">
        <action
            android:id="@+id/action_favoriteCharacterFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/CharacterFragment"
        android:name="alexProject.fragment.character.CharacterFragment"
        android:label="ListCharacterFragment"
        tools:layout="@layout/fragment_character">
        <argument
            android:name="origem"
            app:argType="string" />
        <argument
            android:name="id"
            app:argType="integer" />
        <action
            android:id="@+id/action_CharacterFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />

    </fragment>
    <fragment
        android:id="@+id/timelineFragment"
        android:name="alexProject.fragment.TimelineFragment"
        android:label="SearchCharacterFragment"
        tools:layout="@layout/fragment_timeline">
        <action
            android:id="@+id/action_timelineFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
        <action
            android:id="@+id/action_timelineFragment_to_storyFragment"
            app:destination="@id/storyFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="alexProject.fragment.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_groupFragment"
            app:destination="@id/groupFragment" />
        <action
            android:id="@+id/action_homeFragment_to_comicsFragment"
            app:destination="@id/comicsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_CharacterFragment"
            app:destination="@id/CharacterFragment" />
        <action
            android:id="@+id/action_homeFragment_to_favoriteCharacterFragment"
            app:destination="@id/favoriteCharacterFragment" />
        <action
            android:id="@+id/action_homeFragment_to_timelineFragment"
            app:destination="@id/timelineFragment" />
    </fragment>
    <fragment
        android:id="@+id/comicsFragment"
        android:name="alexProject.fragment.comic.ComicsFragment"
        android:label="ComicsFragment"
        tools:layout="@layout/fragment_comic">
        <argument
            android:name="origem"
            app:argType="string" />
        <argument
            android:name="id"
            app:argType="integer" />
        <action
            android:id="@+id/action_comicsFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/eventFragment"
        android:name="alexProject.fragment.event.EventFragment"
        android:label="EventFragment"
        tools:layout="@layout/fragment_event">
        <argument
            android:name="verity"
            app:argType="string" />
        <argument
            android:name="id"
            app:argType="integer" />
        <action
            android:id="@+id/action_eventFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/storyFragment"
        android:name="alexProject.fragment.StoryFragment"
        android:label="StoryFragment"
        tools:layout="@layout/fragment_story">
        <argument
            android:name="storyModel"
            app:argType="alexProject.data.model.StoryModelData" />
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>

</navigation>