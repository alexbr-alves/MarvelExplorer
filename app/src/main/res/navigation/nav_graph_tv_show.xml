<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_tv_show"
    app:startDestination="@id/tvShowFragment">

    <fragment
        android:id="@+id/tvShowFragment"
        android:name="alexProject.fragment.tvshow.TvShowFragment"
        tools:layout="@layout/fragment_tv_show"
        android:label="TvShowFragment" >
        <action
            android:id="@+id/action_tvShowFragment_to_webViewFragment2"
            app:destination="@id/webViewFragment2" />
    </fragment>
    <fragment
        android:id="@+id/webViewFragment2"
        tools:layout="@layout/fragment_webview"
        android:name="alexProject.fragment.WebViewFragment"
        android:label="WebViewFragment" >
        <argument
            android:name="url"
            app:argType="string" />
        <argument
            android:name="toolbarTitle"
            app:argType="string" />
    </fragment>
</navigation>